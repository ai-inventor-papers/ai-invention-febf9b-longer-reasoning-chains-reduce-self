\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{6}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Main Results: Self-Check Agreement Across CoT Lengths}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Self-check agreement rate and CoT accuracy across short, medium, and long CoT lengths. Agreement peaks at medium CoT (75.6\%) while accuracy is highest at short CoT (83.2\%). Long CoT collapses on both dimensions. Error bars show 95\% confidence intervals from bootstrap resampling.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:fig2}{{3}{6}{Self-check agreement rate and CoT accuracy across short, medium, and long CoT lengths. Agreement peaks at medium CoT (75.6\%) while accuracy is highest at short CoT (83.2\%). Long CoT collapses on both dimensions. Error bars show 95\% confidence intervals from bootstrap resampling}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Consistency-Accuracy Gap}{7}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Consistency-accuracy gap G(L) = Acc(L) - SCA(L) across CoT lengths. Short CoT shows a negative gap (-15.0\%), indicating accurate but inconsistent reasoning. Medium CoT narrows the gap (-6.8\%). Long CoT reverses the gap (+4.9\%), indicating systematic errors that are reproducible but incorrect.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:fig3}{{4}{7}{Consistency-accuracy gap G(L) = Acc(L) - SCA(L) across CoT lengths. Short CoT shows a negative gap (-15.0\%), indicating accurate but inconsistent reasoning. Medium CoT narrows the gap (-6.8\%). Long CoT reverses the gap (+4.9\%), indicating systematic errors that are reproducible but incorrect}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Difficulty-Stratified Analysis}{8}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Self-check agreement rate stratified by difficulty tier (easy, medium, hard) and CoT length (short, medium, long). Long CoT produces the lowest agreement across all tiers, with the largest drop for hard problems (76.0\% to 50.7\%).}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:fig5}{{5}{8}{Self-check agreement rate stratified by difficulty tier (easy, medium, hard) and CoT length (short, medium, long). Long CoT produces the lowest agreement across all tiers, with the largest drop for hard problems (76.0\% to 50.7\%)}{figure.5}{}}
